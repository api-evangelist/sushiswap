              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sender\": \"<string>\",\n  \"pool_address\": \"<string>\",\n  \"chain_id\": \"<integer>\",\n  \"days_to_lock\": \"<integer>\",\n  \"lock_time\": \"<integer>\",\n  \"deposit\": {\n    \"key_0\": \"<string>\",\n    \"key_1\": \"<string>\"\n  },\n  \"output_pool_tokens\": \"<integer>\",\n  \"single_asset\": false,\n  \"single_token\": \"<string>\"\n}",
